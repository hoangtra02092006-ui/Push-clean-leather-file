# URL gốc của backend (bỏ dấu / ở cuối). Khi chạy local: http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# Bật chế độ demo: chạy thuật toán nesting ngay trên trình duyệt, không cần backend.
# true  -> dùng mock (phù hợp deploy Netlify khi chưa có backend)
# false -> gọi API thật ở VITE_API_BASE_URL
VITE_USE_MOCK=true
